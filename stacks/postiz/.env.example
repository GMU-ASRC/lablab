POSTIZ_URL=https://social.autonomousrobotics.club
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
POSTIZ_DB_PASSWORD=change_me_postiz
TEMPORAL_DB_PASSWORD=change_me_temporal
CLOUDFLARE_TUNNEL_TOKEN=paste_tunnel_token_here

# Authentik SSO (optional). Set POSTIZ_GENERIC_OAUTH=true once the
# Application/Provider exists in Authentik to enable the login button.
POSTIZ_GENERIC_OAUTH=false
POSTIZ_AUTHENTIK_CLIENT_ID=change_me
POSTIZ_AUTHENTIK_CLIENT_SECRET=change_me

# Social platform API keys (optional). Leave blank to disable a provider;
# add more to docker-compose.yml following the same pattern if needed.
# LinkedIn: LinkedIn Developer Portal app (Sign In with LinkedIn + Share on LinkedIn products)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Instagram: Meta for Developers app with Instagram Graph API (Business login),
# same app credentials also enable connecting a Facebook Page if wanted later
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# YouTube: Google Cloud OAuth client with the YouTube Data API v3 enabled
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
